def to_binary(n):
    return format(n & 0xFF, '08b')
def binary_arithmetic(a, b, operation):
    if operation == '+':
        result = a + b
    else:
        result = a - b
    binary_result = to_binary(result)
    # Check 8-bit signed overflow
    overflow = result < -128 or result > 127
    if overflow:
        decimal_result = result
    else:
        decimal_result = result
    print("Operand 1:", to_binary(a))
    print("Operand 2:", to_binary(b))
    print("Operation:", operation)
    print("Result (8-bit):", binary_result)
    print("Result (decimal):", decimal_result)
    print("Overflow:", overflow)
    print()
print("Expression 1: 34 + (+27)")
binary_arithmetic(34, 27, '+')
print("Expression 2: (-34) - (-27)")
binary_arithmetic(-34, -27, '-')
